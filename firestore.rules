rules_version = '2';

// DIESEL — Zoelloe Markets
// Publieke leestoegang is nodig omdat de app vóór het inloggen al namen
// uit de 'users'-collectie ophaalt (om te tonen welke namen nog vrij zijn
// bij "Activeren"). Schrijven mag alleen voor ingelogde gebruikers.
// Het is play-money onder vrienden; er staat geen gevoelige data in.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
